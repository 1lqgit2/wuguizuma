*.mdb.meta

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Unity build outputs / caches =====
*.apk
*.aab
*.unitypackage
*.app
/[Ee]xported[Oo]bj/
crashlytics-build.properties
sysinfo.txt

# Unity3D generated crash reports
*.stackdump

# Firebase generated repo (can be regenerated by EDM4U resolve)
/[Aa]ssets/[Gg]enerated[Ll]ocal[Rr]epo/

# Auto-generated meta for ignored folders
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# ===== 抖音小游戏导出目录（可由 Unity 重新导出）=====
/tt-minigame/
project.config.json
game.json

# ===== 插件运行时日志（非源码）=====
/[Aa]ssets/OPS/Obfuscator/Log/

# ===== Agent / tool folders =====
.workbuddy/
